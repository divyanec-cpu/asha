# Template for android/keystore.properties — copy to that name and fill in.
#
# The real file is GITIGNORED because it holds the signing password in
# plaintext. Both it and the .keystore must be backed up somewhere outside this
# repository (a password manager is the right place for both).
#
# WHY BACKUP MATTERS MORE HERE THAN ALMOST ANYWHERE ELSE: a Play Store listing is
# permanently bound to the key that first signed it. Lose the keystore or forget
# the password and the app cannot be updated again — not by you, not by Google,
# not ever. The only remedy is publishing a new listing under a new package name
# and losing every install and review.
#
# storeFile is resolved relative to the android/ directory.

storeFile=asha-release.keystore
storePassword=
keyAlias=asha
keyPassword=
