# ASHA — environment template. Copy to .env.local and fill in.
# .env.local is gitignored and must never be committed (CLAUDE.md, workflow rule 5).

# ── Supabase ────────────────────────────────────────────────────────────────
# From the Supabase dashboard → Project Settings → API.
# The two NEXT_PUBLIC_ values are sent to the browser by design; that is safe,
# because Row Level Security is what protects the data, not key secrecy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service-role key BYPASSES Row Level Security completely. It exists only so
# the seed script can write the shared reference tables, which have no write
# policy. It must never appear in client code, never be prefixed NEXT_PUBLIC_,
# and never be committed. Seed scripts run locally only.
SUPABASE_SERVICE_ROLE_KEY=

# Also needed by scripts/seed-cat-taxonomy.mjs, which reads plain SUPABASE_URL
# rather than the NEXT_PUBLIC_ name. Same value as above.
SUPABASE_URL=

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── MSG91 OTP Widget (Phase 2 — leave blank until then) ─────────────────────
# Real SMS login is production-only: the widget's hCaptcha refuses to run on
# localhost. That is why dev mode below exists.
MSG91_AUTH_KEY=
NEXT_PUBLIC_MSG91_WIDGET_ID=
NEXT_PUBLIC_MSG91_TOKEN_AUTH=

# ── Dev-mode OTP bypass ─────────────────────────────────────────────────────
#
# Replaces the SMS with a code derived deterministically from the phone number.
# Correct for localhost; the real widget's hCaptcha refuses to run there.
#
# DO NOT COPY THESE TWO LINES INTO A HOSTING PROVIDER'S ENVIRONMENT SETTINGS.
# The salt is in this repository, so on a publicly reachable URL a deterministic
# OTP means anyone can compute the code for any phone number and sign in as that
# person. Pasting this file wholesale into Vercel is the mistake this warning
# exists to prevent.
#
# Belt-and-braces: lib/devMode.ts refuses dev mode in any production build
# regardless of these flags, and there is a test pinning that. These lines are
# still scoped to local use — the guard is a backstop, not permission.
MSG91_DEV_MODE=true
NEXT_PUBLIC_MSG91_DEV_MODE=true

# ── No AI keys ──────────────────────────────────────────────────────────────
# v1 has no runtime AI by design (CLAUDE.md). There is deliberately no
# ANTHROPIC_API_KEY here — unlike Dhruva, where there is one.
