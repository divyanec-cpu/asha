{
  "name": "asha",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/lib/**/*.test.ts\"",
    "seed": "node --env-file=.env.local scripts/seed-cat-taxonomy.mjs",
    "seed:gmat-mat": "node --env-file=.env.local scripts/seed-gmat-mat.mjs",
    "seed:practice": "node --env-file=.env.local scripts/seed-practice-qa.mjs",
    "seed:varc": "node --env-file=.env.local scripts/seed-practice-varc.mjs",
    "seed:dilr": "node --env-file=.env.local scripts/seed-practice-dilr.mjs",
    "seed:mock": "node --env-file=.env.local scripts/seed-mock.mjs",
    "seed:all": "npm run seed:practice && npm run seed:varc && npm run seed:dilr && npm run seed:mock",
    "icons": "node scripts/generate-icons.mjs",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:apk": "cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.2",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "comment_overrides": "sharp: libvips CVEs in <0.35.0 (optional dep of next, only used by Image Optimization — which v1 never uses, since ASHA accepts no uploads). postcss: next bundles its own 8.4.31 internally, which carries three advisories; ours is already clean. Both forced to patched versions. Verified `next build` still passes after pinning — if a future next upgrade conflicts, re-check the advisories before loosening these.",
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "^8.5.25"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
